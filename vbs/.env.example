# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose to the browser
# --- Admin access: comma-separated emails allowed into /admin (create the user in Supabase Auth first) ---
ADMIN_EMAILS=founder@example.com
# --- Resend (resend.com > API Keys) ---
RESEND_API_KEY=re_placeholder
EMAIL_FROM="VisionBoard Studio <hello@yourdomain.com>"
